# Copy this to backend/.env and fill in the Google and Slack values.

NODE_ENV=development
LOG_LEVEL=info

PORT=4000
# Slack only allows https redirect URLs, so the API also listens on https with a self-signed
# cert. Set to 0 if you use ngrok/cloudflared instead.
HTTPS_DEV_PORT=4443
FRONTEND_URL=http://localhost:5173

# these match docker-compose.yml (Postgres is on 5433, not 5432)
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5433/reachinbox
RUN_MIGRATIONS_ON_START=true
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# any random string, 32+ chars, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# api.slack.com/apps, scope incoming-webhook. The redirect URL has to be https (see HTTPS_DEV_PORT)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://localhost:4443/api/slack/callback

# scheduler / rate limits
WORKER_CONCURRENCY=5
# min gap between two emails from the same sender
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# per-sender cap per window (a sender row can override it)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# cap across all senders, 0 = off
MAX_EMAILS_PER_HOUR=0
# window length in seconds. 3600 = hourly, use 60 for a quick demo
RATE_LIMIT_WINDOW_SECONDS=3600
# waits shorter than this are slept in the worker, longer ones go back to the delayed set
THROTTLE_INLINE_WAIT_MS=3000
SEND_MAX_ATTEMPTS=3
SEND_RETRY_BACKOFF_MS=15000

# optional basic auth for Bull Board (/admin/queues)
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
